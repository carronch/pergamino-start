# pergamino.local.env — the paths of your two brains.
#
# install.sh writes pergamino.local.env from this template. To write it by hand, copy this file to
# pergamino.local.env in the kit root and change the two paths. Never commit pergamino.local.env.
#
# Rules for this file:
# - One KEY=value line per path. Quotes around a value are optional.
# - A leading ~/ and $HOME are expanded. Nothing else is expanded: the hooks parse this file, they
#   do not run it.
# - Only paths go here. Keep secrets in a password manager, never in this file.
# - A variable in the environment wins over the line in this file.

# The Main brain: the author's own notes. Agents read it and never write to it.
PERGAMINO_MAIN_BRAIN=~/Documents/MainBrain

# The LLM brain: the curated layer the agent keeps (inbox/, Clippings/, raw/, wiki/, reminders/,
# lessons.md, outputs/mainvault-pending/).
PERGAMINO_LLM_BRAIN=~/Documents/LLMBrain
